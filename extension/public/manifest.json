{
  "manifest_version": 3,
  "name": "Browser Connector",
  "version": "0.1.0",
  "description": "Local provider-agnostic browser control for paired MCP agent hosts.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "debugger",
    "tabs",
    "tabGroups",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Browser Connector",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "minimum_chrome_version": "130"
}
